# Monad testnet RPC for the relayer. Use a private endpoint, not a public one (CLAUDE.md).
RPC_URL=
# Relayer wallet that pays gas for players. Must hold MORE than 10 MON: Monad refuses ordinary
# transactions from accounts below its 10 MON reserve. Never commit the real value.
RELAYER_PRIVATE_KEY=
# Optional overrides (defaults shown)
# DEPLOYMENTS_PATH=../deployments/10143.json
# RELAY_LEDGER_PATH=./.data/relay-ledger.json
# PORT=8787
# ALLOWED_ORIGIN=http://localhost:3000
# DAILY_CAP_MON=5
# Per room, per 24 h. Past it a room finishes what is in flight but opens no new question and takes no
# new player. Keep it above a real session (8 people x 8 questions measured ~3.6 MON) and below DAILY_CAP_MON.
# ROOM_DAILY_CAP_MON=4
# MAX_REQUEST_GAS=8000000
# SIGNER_REQUESTS_PER_MINUTE=30
# TOKEN_CALLS_PER_SIGNER_PER_HOUR=4
# TOKEN_CALLS_PER_HOUR=30
