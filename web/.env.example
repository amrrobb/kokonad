# Dynamic sandbox environment ID (app.dynamic.xyz > Developers > SDK & API Keys).
# Required for sign-in and the embedded account. Never commit the real value.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Monad testnet (chain 10143) RPC used by the browser. Public endpoint is fine for the spike;
# the real app must use a private endpoint on participant paths (CLAUDE.md).
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Passkey relying-party ID for the Mera PRF salt. Must equal the host the page is served from
# (no scheme, no port). Leave empty to use window.location.hostname.
NEXT_PUBLIC_PASSKEY_RP_ID=
